# Modèle des variables d'environnement du backend, sans valeurs secrètes.
# En local : copier en .env (ignoré par git) et remplir. Sur le cluster : fournies par la plateforme.

# CSV des SCPI dans un stockage S3 ou compatible (Cloudflare R2) :
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<bucket>/<fichier>
S3_URL=
# Clé d'API R2 en lecture seule (secrets : jamais dans un commit)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optionnel, AWS S3 uniquement (R2 : "auto" par défaut)
# S3_REGION=
